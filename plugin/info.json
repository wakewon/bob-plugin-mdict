{
  "identifier": "com.github.wakewon.mdict",
  "version": "1.1.0",
  "category": "translate",
  "name": "MDict",
  "summary": "查询你自己的本地 MDict（.mdx/.mdd）词典：完全离线，支持英式/美式音标与词典 MDD 音频。",
  "icon": "icon.png",
  "author": "wakewon",
  "homepage": "https://github.com/wakewon/bob-plugin-mdict",
  "tutorial": "https://github.com/wakewon/bob-plugin-mdict#readme",
  "appcast": "https://raw.githubusercontent.com/wakewon/bob-plugin-mdict/main/appcast.json",
  "minBobVersion": "1.20.0",
  "options": [
    {
      "identifier": "serviceURL",
      "type": "text",
      "title": "本地服务地址",
      "defaultValue": "http://127.0.0.1:15321",
      "desc": "bob-mdict 本地服务的地址。默认无需修改。\n\n只有在你用 --port 改过端口时才需要调整。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "http://127.0.0.1:15321"
      }
    },
    {
      "identifier": "dictionaryID",
      "type": "text",
      "title": "词典 ID（可选）",
      "desc": "留空：自动使用第一本包含查询词的词典。\n\n填写：固定只查询该 ID。请在 Bob 中使用 MDict 查询 /list 查看所有词典 ID。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "留空表示自动使用首个命中"
      }
    },
    {
      "identifier": "presentationMode",
      "type": "menu",
      "title": "显示方式",
      "defaultValue": "dict",
      "desc": "词典卡片优先使用 Bob 原生显示；自由排版词条会自动改用纯文本。纯文本和 Markdown 都由本地服务从同一结构化词条直接生成。Bob 当前未正式支持 Markdown 渲染。",
      "menuValues": [
        {
          "title": "词典卡片",
          "value": "dict"
        },
        {
          "title": "纯文本",
          "value": "plain"
        },
        {
          "title": "Markdown",
          "value": "markdown"
        }
      ]
    },
    {
      "identifier": "multiRecordMode",
      "type": "menu",
      "title": "重复词条显示方式",
      "defaultValue": "separate",
      "desc": "分条浏览：只显示一个词条记录，并提供可点击的其他记录入口。\n\n合并显示：在同一结果中使用 ¹ ² ³ 标记展示所有记录。",
      "menuValues": [
        {
          "title": "分条浏览",
          "value": "separate"
        },
        {
          "title": "合并显示",
          "value": "combined"
        }
      ]
    },
    {
      "identifier": "showExamples",
      "type": "menu",
      "title": "显示例句",
      "defaultValue": "enable",
      "menuValues": [
        {
          "title": "显示",
          "value": "enable"
        },
        {
          "title": "隐藏",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "showGrammar",
      "type": "menu",
      "title": "显示语法限定说明",
      "defaultValue": "enable",
      "desc": "控制是否显示详细的语法限定说明（如 [with object] 或 [used especially in negatives and comparatives]）。这不会隐藏词性、释义标签、主题标签、模式、用法说明或例句。",
      "menuValues": [
        {
          "title": "显示",
          "value": "enable"
        },
        {
          "title": "隐藏",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "showExtras",
      "type": "menu",
      "title": "显示扩展内容",
      "defaultValue": "enable",
      "desc": "短语、习语、动词短语、搭配、用法说明、同义词、词源等。",
      "menuValues": [
        {
          "title": "显示",
          "value": "enable"
        },
        {
          "title": "隐藏",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "maxExamples",
      "type": "text",
      "title": "每个释义最多例句数",
      "defaultValue": "3",
      "desc": "限制每个释义或子释义显示的例句数，避免大型语料区过长。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "3"
      }
    }
  ]
}