{
  "identifier": "com.github.wakewon.mdict",
  "version": "1.3.0",
  "category": "translate",
  "name": "MDict",
  "summary": "查询你自己的本地 MDict（.mdx/.mdd）词典：完全离线，支持英式/美式音标与词典 MDD 音频。",
  "icon": "icon.png",
  "author": "wakewon",
  "homepage": "https://github.com/wakewon/bob-plugin-mdict",
  "tutorial": "https://github.com/wakewon/bob-plugin-mdict#readme",
  "appcast": "https://raw.githubusercontent.com/wakewon/bob-plugin-mdict/main/appcast.json",
  "minBobVersion": "1.20.0",
  "options": [
    {
      "identifier": "serviceURL",
      "type": "text",
      "title": "本地服务地址",
      "defaultValue": "http://127.0.0.1:15321",
      "desc": "bob-mdict 本地服务的地址，一般无需修改。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "http://127.0.0.1:15321"
      }
    },
    {
      "identifier": "dictionaryID",
      "type": "text",
      "title": "词典 ID（可选）",
      "desc": "留空时使用第一本收录该词的词典；填写后只查这一本。查询 /list 可查看词典 ID。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "留空表示自动使用首个命中"
      }
    },
    {
      "identifier": "presentationMode",
      "type": "menu",
      "title": "显示方式",
      "defaultValue": "dict",
      "desc": "Markdown 需要 Bob 1.21.0 及以上。网页排版保留词典原有版式，不受例句、语法、扩展内容设置影响。点击链接时若每次弹出确认，可在 Bob 设置中将“打开翻译结果中的链接”改为“从不确认”。",
      "menuValues": [
        {
          "title": "词典卡片",
          "value": "dict"
        },
        {
          "title": "纯文本",
          "value": "plain"
        },
        {
          "title": "Markdown（结构化）",
          "value": "markdown"
        },
        {
          "title": "Markdown（网页排版）",
          "value": "html"
        }
      ]
    },
    {
      "identifier": "multiRecordMode",
      "type": "menu",
      "title": "重复词条显示方式",
      "defaultValue": "separate",
      "desc": "同一词头有多条记录时：分条浏览只显示一条并附其他记录入口；合并显示在同一结果中列出全部。",
      "menuValues": [
        {
          "title": "分条浏览",
          "value": "separate"
        },
        {
          "title": "合并显示",
          "value": "combined"
        }
      ]
    },
    {
      "identifier": "audioVolume",
      "type": "menu",
      "title": "发音音量",
      "defaultValue": "100",
      "desc": "Markdown 中点击 🔊 时的音量。",
      "menuValues": [
        {
          "title": "50%",
          "value": "50"
        },
        {
          "title": "75%",
          "value": "75"
        },
        {
          "title": "100%",
          "value": "100"
        },
        {
          "title": "125%",
          "value": "125"
        },
        {
          "title": "150%",
          "value": "150"
        },
        {
          "title": "200%",
          "value": "200"
        }
      ]
    },
    {
      "identifier": "audioRate",
      "type": "menu",
      "title": "发音语速",
      "defaultValue": "100",
      "desc": "Markdown 中点击 🔊 时的语速，变速不变调。",
      "menuValues": [
        {
          "title": "0.5×",
          "value": "50"
        },
        {
          "title": "0.75×",
          "value": "75"
        },
        {
          "title": "1.0×",
          "value": "100"
        },
        {
          "title": "1.25×",
          "value": "125"
        },
        {
          "title": "1.5×",
          "value": "150"
        }
      ]
    },
    {
      "identifier": "audioNormalize",
      "type": "menu",
      "title": "发音音量均衡",
      "defaultValue": "enable",
      "desc": "把不同词典的录音调到相近的音量。",
      "menuValues": [
        {
          "title": "开启",
          "value": "enable"
        },
        {
          "title": "关闭",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "showExamples",
      "type": "menu",
      "title": "显示例句",
      "defaultValue": "enable",
      "menuValues": [
        {
          "title": "显示",
          "value": "enable"
        },
        {
          "title": "隐藏",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "showGrammar",
      "type": "menu",
      "title": "显示语法限定说明",
      "defaultValue": "enable",
      "desc": "如 [with object]、[used in negatives]。不影响词性、标签和例句。",
      "menuValues": [
        {
          "title": "显示",
          "value": "enable"
        },
        {
          "title": "隐藏",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "showExtras",
      "type": "menu",
      "title": "显示扩展内容",
      "defaultValue": "enable",
      "desc": "短语、习语、搭配、用法说明、同义词、词源等。",
      "menuValues": [
        {
          "title": "显示",
          "value": "enable"
        },
        {
          "title": "隐藏",
          "value": "disable"
        }
      ]
    },
    {
      "identifier": "maxExamples",
      "type": "text",
      "title": "每个释义最多例句数",
      "defaultValue": "3",
      "desc": "每个释义最多显示的例句数。",
      "textConfig": {
        "type": "visible",
        "placeholderText": "3"
      }
    }
  ]
}
